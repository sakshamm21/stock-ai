# Get your OpenAI API Key here: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=****

# Get your Financial Modeling Prep (FMP) API Key here (free tier available): https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=****

# Get your LangSmith API Key here: https://smith.langchain.com/
LANGCHAIN_API_KEY=****
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=ai-financial-agent

# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# PostgreSQL connection string (Supabase, Neon, or any Postgres provider)
POSTGRES_URL=****

# Vercel Blob storage token (auto-created when deploying on Vercel)
BLOB_READ_WRITE_TOKEN=****
